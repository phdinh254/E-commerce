# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce
DATABASE_PASSWORD=change-me-in-local-env
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-hex-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# SMTP (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Supabase Storage (Storage only — not used as a database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Admin seed (used only by the seed script, never hardcoded in source)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_FULL_NAME=System Admin
