# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Frontend origin used to build verification/reset-password links in emails.
FRONTEND_URL=http://localhost:3001
APP_NAME=E-commerce

# Logging (Pino). One of: fatal, error, warn, info, debug, trace, silent.
# If unset, defaults by NODE_ENV: development=debug, test=silent, production=info.
LOG_LEVEL=debug

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce
DATABASE_PASSWORD=change-me-in-local-env
DATABASE_SSL=false
# Connection pool (node-postgres). Defaults are sane for a single backend
# instance; raise DB_POOL_MAX only after checking PostgreSQL's max_connections.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-hex-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Google OAuth ("Sign in with Google"). Optional — leave all three empty to
# disable the feature entirely; /auth/google then responds 503 instead of
# starting a broken flow. See docs/google-oauth-setup.md for how to create
# these in Google Cloud Console (never commit real values here).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# SMTP (Mailpit in development). To send through Gmail SMTP for a demo, see
# docs/gmail-app-password.md — never put a real Gmail App Password here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Supabase Storage (Storage only — not used as a database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Admin seed (used only by the seed script, never hardcoded in source)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_FULL_NAME=System Admin
